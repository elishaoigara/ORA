# Copy this file to .env.production on the backend host and replace every placeholder.
# Never commit .env.production.

APP_ENV=production
PORT=8000
TZ=Africa/Nairobi

# Public API and frontend
API_DOMAIN=api.example.com
FRONTEND_URL=https://your-ora.vercel.app
CORS_ORIGINS=https://your-ora.vercel.app

# Generate long random values. Use different values for these two variables.
ORA_API_TOKEN=replace-with-long-random-api-token
ORA_INTERNAL_TOKEN=replace-with-different-long-random-internal-token

# Durable application data inside the Docker volume
ORA_DATA_DIR=/opt/ora-data
ORA_LOOP_INTERVAL=300

# LLM and messaging
GROQ_API_KEY=
GROQ_MODEL_PRIMARY=llama-3.3-70b-versatile
GROQ_MODEL_FALLBACK=llama-3.1-8b-instant
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google OAuth and APIs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.example.com/api/auth/google/callback

# Optional integrations
TAVILY_API_KEY=
GITHUB_TOKEN=
GITHUB_USERNAME=
WA_SIDECAR_URL=

# Weather defaults: Juja/Nairobi area
WEATHER_LAT=-1.2921
WEATHER_LON=36.8219

# Optional payments/mobile money settings, if enabled by the application
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
