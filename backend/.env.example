APP_ENV=development
ORA_LOCAL_DB=ora-mini.db
# Required for production; optional locally. SQLite is NEVER used on Render Free.
DATABASE_URL=
ORA_API_TOKEN=choose-a-long-random-local-key
DEEPSEEK_API_KEY=
# Optional: retain Groq only for voice transcription and image analysis.
GROQ_API_KEY=
CORS_ORIGINS=http://localhost:5173
DEEPSEEK_MODEL=deepseek-flash
ORA_DAILY_AI_REQUESTS=100
# Telegram is delivered to the Render API, not the Vercel frontend.
TELEGRAM_BOT_TOKEN=
# Optional override; Render supplies RENDER_EXTERNAL_URL automatically.
ORA_PUBLIC_URL=

